<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
		<PackageReference Include="CloudinaryDotNet" Version="1.29.3" />
		<PackageReference Include="FirebaseAdmin" Version="3.7.0" />
		<PackageReference Include="FirebaseAdminCore" Version="2.0.0" />
		<PackageReference Include="FirebaseDatabase.net" Version="5.0.0" />
		<PackageReference Include="Google.Cloud.Firestore" Version="4.4.0" />
		<PackageReference Include="Microsoft.AspNetCore.Http.Features" Version="5.0.17" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
		<PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NewBalanceStore.Application\NewBalanceStore.Application.csproj" />
		<ProjectReference Include="..\NewBalanceStore.Domain\NewBalanceStore.Domain.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Templates\email-verification.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>